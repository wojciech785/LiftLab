{
  "name": "@lift-lab/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.contracts.json",
    "test": "npm run build && node --test test/*.test.cjs",
    "codegen": "graphql-codegen --config codegen.mjs",
    "codegen:check": "graphql-codegen --config codegen.mjs --check"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@lift-lab/shared-types": "*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "graphql": "^17.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typed-document-node": "^7.2.0",
    "@graphql-codegen/typescript-operations": "^6.2.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  }
}
