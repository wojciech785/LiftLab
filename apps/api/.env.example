# Server-only Hygraph configuration. Do not use a VITE_ prefix here.
PORT=3001
WEB_ORIGIN=http://localhost:5173
HYGRAPH_CONTENT_API_URL=
HYGRAPH_CONTENT_API_TOKEN=
HYGRAPH_MUTATION_API_URL=
HYGRAPH_MUTATION_API_TOKEN=
HYGRAPH_WEBHOOK_SECRET=
# Permanent token with Management API permissions. Used only by schema migrations.
HYGRAPH_MANAGEMENT_API_TOKEN=
# Optional. Defaults to HYGRAPH_CONTENT_API_URL when omitted.
HYGRAPH_SCHEMA_API_ENDPOINT=
HYGRAPH_MCP_ENDPOINT=
HYGRAPH_MCP_PAT=
