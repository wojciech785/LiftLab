{
  "name": "lift-lab",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@lift-lab/web",
    "dev:api": "npm run start:dev --workspace=@lift-lab/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm run codegen:check && npm test --workspaces --if-present",
    "hygraph:schema:refresh": "node --env-file=apps/api/.env scripts/hygraph/refresh-schema.mjs",
    "codegen": "npm run codegen --workspace=@lift-lab/api",
    "codegen:check": "npm run codegen:check --workspace=@lift-lab/api",
    "hygraph:schema:foundation:plan": "node scripts/hygraph/apply-foundation.mjs",
    "hygraph:schema:foundation:apply": "node scripts/hygraph/apply-foundation.mjs --apply",
    "hygraph:schema:workflow-localization:plan": "node scripts/hygraph/apply-workflow-localization.mjs",
    "hygraph:schema:workflow-localization:apply": "node scripts/hygraph/apply-workflow-localization.mjs --apply",
    "hygraph:schema:programme-article-core:plan": "node scripts/hygraph/apply-programme-article-core.mjs",
    "hygraph:schema:programme-article-core:apply": "node scripts/hygraph/apply-programme-article-core.mjs --apply",
    "hygraph:schema:article-blocks-media:plan": "node scripts/hygraph/apply-article-blocks-media.mjs",
    "hygraph:schema:article-blocks-media:apply": "node scripts/hygraph/apply-article-blocks-media.mjs --apply",
    "hygraph:schema:workout-intents:plan": "node scripts/hygraph/apply-workout-intents.mjs",
    "hygraph:schema:workout-intents:apply": "node scripts/hygraph/apply-workout-intents.mjs --apply"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hygraph/management-sdk": "^1.6.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2"
  }
}
